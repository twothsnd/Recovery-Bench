#!/usr/bin/env bash
set -euo pipefail

delay="${TB2_LOCAL_PKG_DELAY_SEC:-5}"
wheelhouse="${TB2_WHEELHOUSE_IN_CONTAINER:-/opt/tb2/wheelhouse}"

export UV_INDEX_URL="${UV_INDEX_URL:-https://mirrors.aliyun.com/pypi/simple/}"
export UV_PYTHON_INSTALL_MIRROR="${UV_PYTHON_INSTALL_MIRROR:-https://mirrors.ustc.edu.cn/github-release/astral-sh/python-build-standalone/}"

extra=()
if [[ "$#" -ge 2 && "$1" == "pip" && "$2" == "install" ]]; then
  if [[ "$delay" =~ ^[0-9]+$ && "$delay" -gt 0 ]]; then
    sleep "$delay"
  fi
  if [[ -d "$wheelhouse" ]]; then
    for d in "$wheelhouse"/cp* "$wheelhouse"/universal; do
      [[ -d "$d" ]] || continue
      compgen -G "$d/*.whl" >/dev/null || continue
      extra+=(--find-links "file://$d")
    done
  fi
fi

case " $* " in
  *" --find-links "*|*" -f "*) extra=() ;;
esac

real="${REAL_UV:-/usr/local/bin/uv.real}"
if [[ ! -x "$real" ]]; then
  real="$(command -v uv.real || true)"
fi
if [[ -z "$real" || ! -x "$real" ]]; then
  echo "uv shim: real uv binary not found" >&2
  exit 127
fi

if [[ "$#" -ge 2 && "$1" == "pip" && "$2" == "install" && "${#extra[@]}" -gt 0 ]]; then
  exec "$real" "$1" "$2" "${extra[@]}" "${@:3}"
fi
exec "$real" "$@"
